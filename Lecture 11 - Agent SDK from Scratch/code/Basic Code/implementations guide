## Chapter 5 — Harness ReAct Pipeline (`src/harness/reasoning-engine.ts`)

**Notes reference:** Chapter 03 (Harness Prompting & ReAct Pipeline)

### File details
- **Path:** `src/harness/reasoning-engine.ts`
- **Command:** Create file

### Full code

```ts
import { Message, ToolResult } from '../types/types';
import { ToolRegistry } from '../services/tool-registry';
import { LLMEngine } from '../types/types';
import { MessageHistory } from '../core/message-history';

/**
 * Harness ReAct Pipeline - the 5-stage state machine.
 * Based on Chapter 03 (Harness Prompting & ReAct Pipeline).
 *
 * Stages: INITIAL -> THINK -> TOOL_REQUEST -> ANALYSE -> OUTPUT
 */

export type HarnessStage = 'INITIAL' | 'THINK' | 'TOOL_REQUEST' | 'ANALYSE' | 'OUTPUT';

export class HarnessPipeline {
  private readonly maxLoop: number;

  constructor(
    private readonly llmEngine: LLMEngine,
    private readonly toolRegistry: ToolRegistry,
    private readonly systemPrompt: string,
    maxLoop = 10
  ) {
    this.maxLoop = maxLoop;
  }

  async run(input: string, history: MessageHistory): Promise<string> {
    let messages: Message[] = [];
    let toolCalls: Array<{ name: string; args: Record<string, unknown> }> = [];
    let finalOutput = '';
    let iteration = 0;
    let stage: HarnessStage = 'INITIAL';

    while (iteration < this.maxLoop) {
      if (stage === 'INITIAL') {
        messages = [
          { role: 'system', content: this.systemPrompt },
          ...history.getMessages(),
          { role: 'user', content: input },
        ];
        stage = 'THINK';
      } else if (stage === 'THINK') {
        const response = await this.llmEngine.generate(messages);
        messages.push({ role: 'assistant', content: response });

        if (this.hasToolCall(response)) {
          toolCalls = this.parseToolCalls(response);
          stage = 'TOOL_REQUEST';
        } else {
          finalOutput = response;
          stage = 'OUTPUT';
        }
      } else if (stage === 'TOOL_REQUEST') {
        for (const call of toolCalls) {
          const result = await this.toolRegistry.execute(call.name, call.args);
          messages.push({ role: 'tool', content: result.content });
        }
        toolCalls = [];
        stage = 'ANALYSE';
      } else if (stage === 'ANALYSE') {
        stage = 'THINK';
      } else if (stage === 'OUTPUT') {
        return finalOutput;
      }
      iteration++;
    }

    return 'Error: Max loop iterations reached';
  }

  private hasToolCall(response: string): boolean {
    return response.includes('"toolCall"') || response.includes('tool_call');
  }

  private parseToolCalls(response: string): Array<{ name: string; args: Record<string, unknown> }> {
    try {
      const json = JSON.parse(response);
      if (json.toolCalls && Array.isArray(json.toolCalls)) {
        return json.toolCalls;
      }
    } catch {
      // Not JSON, ignore
    }
    return [];
  }
}
```

### Block by block explanation

| Code block | What it does |
|---|---|
| `export type HarnessStage = ...` | The 5-stage state machine: `INITIAL → THINK → TOOL_REQUEST → ANALYSE → OUTPUT`. |
| `constructor(llmEngine, toolRegistry, systemPrompt, maxLoop)` | Stores the LLM engine, tool registry, system prompt, and max loop safety cap. |
| `while (iteration < this.maxLoop)` | The main ReAct loop. Stops after `maxLoop` iterations to prevent infinite execution. |
| `if (stage === 'INITIAL')` | Builds the message array: system prompt + history + current user input. |
| `else if (stage === 'THINK')` | Calls `llmEngine.generate(messages)`. If the response contains a tool call, go to `TOOL_REQUEST`; otherwise go to `OUTPUT` with the response as final output. |
| `else if (stage === 'TOOL_REQUEST')` | Executes each requested tool via `toolRegistry.execute()` and appends results as tool messages. |
| `else if (stage === 'ANALYSE')` | Resets tool calls/results and loops back to `THINK` so the LLM can reason again with the new tool results. |
| `else if (stage === 'OUTPUT')` | Returns the final output string. |
| `hasToolCall(response)` | Detects whether the LLM response contains a tool call request. |
| `parseToolCalls(response)` | Parses JSON tool calls from the LLM response. Returns empty array if parsing fails (defensive). |

