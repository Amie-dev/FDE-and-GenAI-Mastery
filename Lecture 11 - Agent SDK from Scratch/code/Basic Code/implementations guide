## Chapter 4 — Message History Core (`src/core/message-history.ts`)

**Notes reference:** Chapter 05 (Message State, Execution & Interceptors)

### File details
- **Path:** `src/core/message-history.ts`
- **Command:** Create file

### Full code

```ts
import { Message, MessageRole, LLMEngine } from '../types/types';

/**
 * MessageHistory - manages conversation history.
 * Based on Chapter 05 (Message State, Execution & Interceptors).
 *
 * Supports addMessage, getMessages, clear, and interceptor hooks.
 */

export type Interceptor = (message: Message) => Message | null;

export class MessageHistory {
  private messages: Message[] = [];
  private interceptors: Interceptor[] = [];

  addMessage(message: Message): void {
    for (const interceptor of this.interceptors) {
      const result = interceptor(message);
      if (result === null) return;
      message = result;
    }
    this.messages.push(message);
  }

  addUserMessage(content: string): void {
    this.addMessage({ role: 'user', content });
  }

  addAssistantMessage(content: string): void {
    this.addMessage({ role: 'assistant', content });
  }

  addToolMessage(content: string): void {
    this.addMessage({ role: 'tool', content });
  }

  getMessages(): Message[] {
    return [...this.messages];
  }

  clear(): void {
    this.messages = [];
  }

  use(interceptor: Interceptor): void {
    this.interceptors.push(interceptor);
  }
}

/**
 * LLM Engine implementation - basic wrapper around an LLM call.
 * Based on Chapter 01 (LLM Engine) - abstraction over LLM provider.
 */
export class BasicLLMEngine implements LLMEngine {
  constructor(private readonly systemPrompt: string) {}

  async generate(messages: Message[]): Promise<string> {
    const lastUser = [...messages].reverse().find((m) => m.role === 'user');
    return lastUser ? `Echo: ${lastUser.content}` : 'Echo: Hello';
  }
}
```

### Block by block explanation

| Code block | What it does |
|---|---|
| `export type Interceptor = (message) => Message \| null` | An interceptor can observe or modify a message. Returning `null` drops the message. |
| `private messages: Message[] = []` | Internal array storing the conversation history. |
| `private interceptors: Interceptor[] = []` | Registered interceptor hooks. |
| `addMessage(message): void` | Runs the message through every interceptor. If any returns `null`, the message is dropped. Otherwise the (possibly modified) message is stored. |
| `addUserMessage / addAssistantMessage / addToolMessage(content)` | Convenience methods that add a message with a specific role. |
| `getMessages(): Message[]` | Returns a shallow copy of all messages so callers can't mutate internal state. |
| `clear(): void` | Empties the history. |
| `use(interceptor): void` | Registers a new interceptor hook (used for logging, tracing, auditing). |
| `class BasicLLMEngine implements LLMEngine` | Minimal LLM engine for learning. It finds the last user message and echoes it back. In production this would call a real LLM provider (OpenAI, Gemini, etc.). |

