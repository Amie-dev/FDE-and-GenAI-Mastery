# ---- HTTP -------------------------------------------------------------------
PORT=8097

# ---- Model (chapter 01 §01.3, chapter 07 §07.1) -----------------------------
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.3
# B_output — bounds the worst-case completion cost (chapter 09 §09.9).
AI_MAX_TOKENS=400

# ---- Delivery policy: the stream pump (chapter 07 §07.6) --------------------
# Coalesce deltas: flush when EITHER threshold is hit (chapter 03 §03.3).
# Never delays the FIRST piece — TTFT is what the user feels.
FLUSH_INTERVAL_MS=40
FLUSH_BYTES=256

# ---- Keep-alive (chapter 05 §05.3.3) ---------------------------------------
# A no-op comment every 10-15 s, comfortably below the smallest 30 s idle timeout.
HEARTBEAT_MS=15000

# ---- Simulated cadence for OFFLINE mode (chapter 01 §01.3) -----------------
# T_prefill (the parallel phase that sets TTFT) and T_ITL (the serial decode).
OFFLINE_TTFT_MS=250
OFFLINE_ITL_MS=25

# ---- Request shape (chapter 02 §02.8) --------------------------------------
MAX_INPUT_CHARS=8000

# ---- Credentials -----------------------------------------------------------
# With no key the lab runs in OFFLINE mode: the whole pipeline, both transports,
# the codec and the torture test still work against a deterministic stub
# (chapter 01 §01.5 — the same loop, two delivery shapes).
OPENAI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
