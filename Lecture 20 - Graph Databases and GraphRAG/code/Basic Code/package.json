{
  "name": "lecture-20-graphrag-basic-code",
  "version": "1.0.0",
  "private": true,
  "description": "Minimum Express + TypeScript GraphRAG basic code: Neo4j driver, Cypher library, vector+graph retrieval, agent memory.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "bootstrap": "tsx scripts/bootstrap.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "neo4j-driver": "^5.19.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2"
  }
}
