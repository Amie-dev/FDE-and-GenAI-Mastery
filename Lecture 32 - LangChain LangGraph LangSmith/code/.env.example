# LangChain / model provider
OPENAI_API_KEY=sk-your-openai-api-key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# GEMINI_API_KEY=your-gemini-api-key

# Search tool (optional, for web search / research workflows)
# TAVILY_API_KEY=tvly-your-tavily-api-key

# Notion workflow (optional)
# NOTION_API_KEY=secret_your-notion-api-key
# NOTION_PAGE_ID=your-notion-parent-page-id

# LangSmith tracing / observability
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=ls-your-langsmith-api-key
LANGSMITH_PROJECT=lecture-32

# Agent-based workspace (optional)
# LANGSMITH_AGENT_ID=your-agent-id
# LANGSMITH_AGENT_ENVIRONMENT=local
