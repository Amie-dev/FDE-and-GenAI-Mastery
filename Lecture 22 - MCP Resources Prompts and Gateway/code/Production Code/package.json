{
  "name": "task-mcp-production",
  "version": "1.0.0",
  "description": "Production MCP server + host — Task management with Tools, Resources, and Prompts",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "server": "tsx src/server/index.ts",
    "host": "tsx src/host/index.ts",
    "build": "tsc",
    "dev:server": "tsx src/server/index.ts",
    "dev:host": "tsx src/host/index.ts",
    "dev": "tsx src/server/index.ts & tsx src/host/index.ts",
    "lifecycle": "tsx src/client/lifecycle.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts --report-unused-disable-directives",
    "start:server": "tsx src/server/index.ts",
    "start:host": "tsx src/host/index.ts"
  },
  "keywords": [
    "fde",
    "mcp",
    "model-context-protocol",
    "resources",
    "prompts",
    "tools",
    "typescript"
  ],
  "author": "Forward Deployed Engineering Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "openai": "^6.0.0",
    "zod": "^4.2.0",
    "pino": "^9.0.0",
    "helmet": "^8.0.0",
    "cors": "^2.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  }
}